# shellcheck disable=SC2207

_ablestack_vm_ftctl()
{
  local cur prev words cword
  _init_completion -n : || return

  local -a commands=(
    protect status reconcile failover failover-prepare failback failback-sync failback-reprotect unprotect fence-confirm fence-clear
    pause-protection resume-protection check health
    dr-plan-apply dr-sync-start dr-sync-pause dr-sync-resume dr-test-failover dr-test-cleanup
    dr-failover dr-failback dr-reprotect dr-target-materialized dr-cutover-commit dr-release dr-status dr-transition-preflight dr-capabilities dr-cancel
    config
  )

  local -a global_opts=(
    -h --help -V --version
    --vm --mode --peer --profile --config --policy
    --dry-run --json --force
    --plan --run --profile-json --restore-point --events-offset --events-limit --wait
    --session-id --checkpoint-sequence --authority-generation --target-power-state --boot-validation-state
    --cluster-name --local-host-id --host-id --role
    --management-ip --libvirt-uri --blockcopy-ip
    --xcolo-control-ip --xcolo-data-ip
    --backend-mode --provisioning-backend --target-storage-scope --secondary-vm-name --active-side --fencing-policy
    --fencing-ipmi-primary-host --fencing-ipmi-primary-port
    --fencing-ipmi-primary-user --fencing-ipmi-primary-password --fencing-ipmi-primary-interface
    --fencing-ipmi-secondary-host --fencing-ipmi-secondary-port
    --fencing-ipmi-secondary-user --fencing-ipmi-secondary-password --fencing-ipmi-secondary-interface
    --secondary-target-dir --remote-nbd-export-addr
    --xcolo-proxy-endpoint --xcolo-nbd-endpoint --xcolo-migrate-uri
  )

  case "${prev}" in
    --mode)
      COMPREPLY=( $(compgen -W "ha dr ft" -- "${cur}") )
      return 0
      ;;
    --config|--profile-json)
      COMPREPLY=( $(compgen -f -- "${cur}") )
      return 0
      ;;
    --role)
      COMPREPLY=( $(compgen -W "primary secondary observer generic" -- "${cur}") )
      return 0
      ;;
    --backend-mode)
      COMPREPLY=( $(compgen -W "shared-blockcopy remote-nbd" -- "${cur}") )
      return 0
      ;;
    --provisioning-backend)
      COMPREPLY=( $(compgen -W "libvirt-managed cloud-managed" -- "${cur}") )
      return 0
      ;;
    --active-side)
      COMPREPLY=( $(compgen -W "primary secondary" -- "${cur}") )
      return 0
      ;;
    --target-storage-scope)
      COMPREPLY=( $(compgen -W "shared secondary-local" -- "${cur}") )
      return 0
      ;;
    --fencing-policy)
      COMPREPLY=( $(compgen -W "manual-block ssh peer-virsh-destroy ipmi redfish" -- "${cur}") )
      return 0
      ;;
    --vm|--peer|--profile|--policy|--plan|--run|--restore-point|--events-offset|--events-limit|--wait|--session-id|--checkpoint-sequence|--authority-generation|--target-power-state|--boot-validation-state|--cluster-name|--local-host-id|--host-id|--management-ip|--libvirt-uri|--blockcopy-ip|--xcolo-control-ip|--xcolo-data-ip|--secondary-vm-name|--fencing-ipmi-primary-host|--fencing-ipmi-primary-port|--fencing-ipmi-primary-user|--fencing-ipmi-primary-password|--fencing-ipmi-primary-interface|--fencing-ipmi-secondary-host|--fencing-ipmi-secondary-port|--fencing-ipmi-secondary-user|--fencing-ipmi-secondary-password|--fencing-ipmi-secondary-interface|--secondary-target-dir|--remote-nbd-export-addr|--xcolo-proxy-endpoint|--xcolo-nbd-endpoint|--xcolo-migrate-uri)
      return 0
      ;;
  esac

  local cmd=""
  local i=1
  while (( i < cword )); do
    case "${words[i]}" in
      --vm|--mode|--peer|--profile|--config|--policy|--plan|--run|--profile-json|--restore-point|--events-offset|--wait|--session-id|--checkpoint-sequence|--authority-generation|--target-power-state|--boot-validation-state|--cluster-name|--local-host-id|--host-id|--role|--management-ip|--libvirt-uri|--blockcopy-ip|--xcolo-control-ip|--xcolo-data-ip|--backend-mode|--provisioning-backend|--target-storage-scope|--secondary-vm-name|--active-side|--fencing-policy|--fencing-ipmi-primary-host|--fencing-ipmi-primary-port|--fencing-ipmi-primary-user|--fencing-ipmi-primary-password|--fencing-ipmi-primary-interface|--fencing-ipmi-secondary-host|--fencing-ipmi-secondary-port|--fencing-ipmi-secondary-user|--fencing-ipmi-secondary-password|--fencing-ipmi-secondary-interface|--secondary-target-dir|--remote-nbd-export-addr|--xcolo-proxy-endpoint|--xcolo-nbd-endpoint|--xcolo-migrate-uri)
        ((i+=2))
        continue
        ;;
      --dry-run|--json|--force|-h|--help|-V|--version)
        ((i+=1))
        continue
        ;;
      -*)
        ((i+=1))
        continue
        ;;
      *)
        cmd="${words[i]}"
        break
        ;;
    esac
  done

  if [[ -z "${cmd}" ]]; then
    if [[ "${cur}" == -* ]]; then
      COMPREPLY=( $(compgen -W "${global_opts[*]}" -- "${cur}") )
    else
      COMPREPLY=( $(compgen -W "${commands[*]}" -- "${cur}") )
    fi
    return 0
  fi

  case "${cmd}" in
    protect)
      COMPREPLY=( $(compgen -W "--vm --mode --peer --profile --config --policy --dry-run --json" -- "${cur}") )
      ;;
    status|reconcile|check)
      COMPREPLY=( $(compgen -W "--vm --config --policy --dry-run --json" -- "${cur}") )
      ;;
    failover|failover-prepare|failback|failback-sync|failback-reprotect|unprotect)
      COMPREPLY=( $(compgen -W "--vm --config --policy --json --force" -- "${cur}") )
      ;;
    fence-confirm|fence-clear)
      COMPREPLY=( $(compgen -W "--vm --config --policy" -- "${cur}") )
      ;;
    pause-protection|resume-protection)
      COMPREPLY=( $(compgen -W "--vm --config --policy" -- "${cur}") )
      ;;
    dr-plan-apply)
      COMPREPLY=( $(compgen -W "--plan --profile-json --role --dry-run --json --config --policy" -- "${cur}") )
      ;;
    dr-sync-start|dr-sync-pause|dr-sync-resume|dr-test-failover|dr-test-cleanup|dr-failover|dr-failback|dr-reprotect|dr-release)
      COMPREPLY=( $(compgen -W "--plan --run --profile-json --role --mode --restore-point --force --dry-run --wait --json --config --policy" -- "${cur}") )
      ;;
    dr-target-materialized)
      COMPREPLY=( $(compgen -W "--plan --run --restore-point --json --config --policy" -- "${cur}") )
      ;;
    dr-cutover-commit)
      COMPREPLY=( $(compgen -W "--plan --run --session-id --checkpoint-sequence --authority-generation --target-power-state --boot-validation-state --json --config --policy" -- "${cur}") )
      ;;
    dr-status)
      COMPREPLY=( $(compgen -W "--plan --run --events-offset --events-limit --json --config --policy" -- "${cur}") )
      ;;
    dr-transition-preflight)
      COMPREPLY=( $(compgen -W "--plan --operation --expected-authority --authority-generation --json --config --policy" -- "${cur}") )
      ;;
    dr-capabilities)
      COMPREPLY=( $(compgen -W "--json --config --policy" -- "${cur}") )
      ;;
    dr-cancel)
      COMPREPLY=( $(compgen -W "--plan --run --force --json --config --policy" -- "${cur}") )
      ;;
    health)
      COMPREPLY=( $(compgen -W "--config --policy --json" -- "${cur}") )
      ;;
    config)
      COMPREPLY=( $(compgen -W "init-cluster set-local-host show host-upsert host-remove host-list profile-upsert profile-remove profile-show ${global_opts[*]}" -- "${cur}") )
      ;;
    *)
      COMPREPLY=()
      ;;
  esac
}

complete -F _ablestack_vm_ftctl ablestack_vm_ftctl
